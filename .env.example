# Supabase project shared with the original portfolio's admin panel.
# When either value is empty the site renders its built-in content instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# EmailJS, used by the contact form. Leave empty to disable sending.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
